# =============================================================================
# INAVIT · inventario de hosts (plantilla). Copia a hosts.env y llénalo.
# hosts.env está en .gitignore: no lo subas al repositorio.
# =============================================================================

# ---- VM1: SAP HANA Express + Db2 (Docker, RHEL 9.8) -------------------------
VM1_HOST=<ip-o-host-vm1>
VM1_USER=itzuser
HANA_PORT=39041          # tenant HXE
DB2_PORT=50000           # base INAVITDB, usuario db2inst1

# ---- VM2: DataStage Remote Engine (Docker) + IIDR Access Server (RHEL 9.8) ---
VM2_HOST=<ip-o-host-vm2>
VM2_USER=itzuser

# ---- VM3: staging (Windows Server 2025: SQL Server + PostgreSQL + IIDR) ------
VM3_HOST=<ip-o-host-vm3>
VM3_USER=<usuario-windows>
SQLSERVER_PORT=1433      # base INAVIT_STG, esquema INAVIT_APO
POSTGRES_PORT=5432       # base inavit_stg, esquema hana_raw

# ---- VM4: watsonx.data Developer Edition (RHEL 9.8) --------------------------
VM4_HOST=<ip-o-host-vm4>
VM4_USER=itzuser
WXD_CONSOLE_PORT=6443    # lhconsole-ui-svc:443
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
PRESTO_PORT=8443

# ---- VM5: Cognos Analytics 12.1.3 (RHEL 9.8) ---------------------------------
VM5_HOST=<ip-o-host-vm5>
VM5_USER=itzuser
COGNOS_PORT=9300         # http://localhost:9300/bi/

# ---- Netezza SaaS (Azure, East US 2; administrado desde IBM Cloud) ------------
NZ_HOST=<id>.<region>.data-warehouse.cloud.ibm.com
NZ_PORT=5480
NZ_DATABASE=<BASE>       # en el proyecto original: la base del usuario de la instancia
NZ_SCHEMA=INAVIT_DW
NZ_USER=<usuario>
