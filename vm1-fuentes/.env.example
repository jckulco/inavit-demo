# =============================================================================
# INAVIT · VM1 (fuentes de datos) · configuración
# scripts/00-init-env.sh copia este archivo a .env y genera las contraseñas.
# Reglas de contraseña: >= 8 caracteres, mayúscula + minúscula + número,
# SIN comillas, SIN ` $ \ ni espacios.
# =============================================================================

# ---- Imágenes y contenedores ------------------------------------------------
HANA_IMAGE=saplabs/hanaexpress:latest
# Versión fija de Db2 (mantenla alineada con el cliente Db2 que instalarás en el host para IIDR).
DB2_IMAGE=icr.io/db2_community/db2:12.1.5.0
HANA_CONTAINER=hxe
DB2_CONTAINER=db2server
DOCKER_NETWORK=sap-demo-net

# ---- Rutas (todo en el disco grande: /opt) -----------------------------------
BASE_DIR=/opt/inavit
HANA_DATA_DIR=/opt/inavit/saphana
DB2_DATA_DIR=/opt/inavit/db2/database
DATA_DIR=/opt/inavit/data
# Solo para scripts/01b-move-docker-root.sh (mueve /var/lib/docker a un disco grande)
DOCKER_DATA_ROOT=/opt/docker

# ---- SAP HANA Express ---------------------------------------------------------
HANA_INSTANCE=90
HANA_TENANT=HXE
HANA_SQL_PORT=39041
HANA_MASTER_PASSWORD=
# Límite de memoria del motor HANA en MB (para dejar RAM a Db2 y al motor de replicación)
HANA_MEM_LIMIT_MB=16384
# Usuario de aplicación para DataStage (solo lectura sobre INAVIT_FIN)
HANA_APP_USER=INAVIT_DS
HANA_APP_PASSWORD=

# ---- Db2 ---------------------------------------------------------------------
DB2_DBNAME=INAVITDB
DB2_PORT=50000
DB2_PASSWORD=
# Memoria de la instancia Db2 en GB
DB2_INSTANCE_MEMORY_GB=6

# ---- Volumen de datos sintéticos -----------------------------------------------
SCALE_WORKERS=250000
SCALE_PATRONES=15000
BIMESTRES=12
PAGO_MESES=24
SEED=20261102
# Fecha "de hoy" de los datos (vacío = fecha del servidor al generar).
# 2026-11-02 reproduce exactamente las cifras de referencia del proyecto (periodos 202405..202604).
AS_OF=2026-11-02
